      "opacity": 100, "angle": 0, "seed": 140001, "version": 1, "versionNonce": 140002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "cap0", "x": 80, "y": 586, "width": 300, "height": 80,
      "text": "A new TCP connection +\nhandshake for every asset.\nNo `Host` header. Slowest.",
      "originalText": "A new TCP connection +\nhandshake for every asset.\nNo `Host` header. Slowest.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 140003, "version": 1, "versionNonce": 140004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },
    {
      "type": "text", "id": "lead1", "x": 420, "y": 560, "width": 300, "height": 22,
      "text": "one persistent connection", "originalText": "one persistent connection",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 140005, "version": 1, "versionNonce": 140006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "cap1", "x": 420, "y": 586, "width": 300, "height": 80,
      "text": "Reuse one connection, but one\nrequest at a time (app-level\nHOL). ~6 connections per domain.",
      "originalText": "Reuse one connection, but one\nrequest at a time (app-level\nHOL). ~6 connections per domain.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 140007, "version": 1, "versionNonce": 140008, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },
    {
      "type": "text", "id": "lead2", "x": 760, "y": 560, "width": 320, "height": 22,
      "text": "one TCP connection (multiplexed)", "originalText": "one TCP connection (multiplexed)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 140009, "version": 1, "versionNonce": 140010, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "cap2", "x": 760, "y": 586, "width": 300, "height": 80,
      "text": "Many streams over one TCP\nconnection + HPACK. A lost\npacket stalls ALL streams (TCP HOL).",
      "originalText": "Many streams over one TCP\nconnection + HPACK. A lost\npacket stalls ALL streams (TCP HOL).",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 140011, "version": 1, "versionNonce": 140012, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },
    {
      "type": "text", "id": "lead3", "x": 1100, "y": 560, "width": 320, "height": 22,
      "text": "independent streams (QUIC/UDP)", "originalText": "independent streams (QUIC/UDP)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 140013, "version": 1, "versionNonce": 140014, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "cap3", "x": 1100, "y": 586, "width": 300, "height": 80,
      "text": "Independent streams over\nQUIC — a lost packet stalls\nonly its own. 0-RTT setup.",
      "originalText": "Independent streams over\nQUIC — a lost packet stalls\nonly its own. 0-RTT setup.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "angle": 0, "seed": 140015, "version": 1, "versionNonce": 140016, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3
    },
    {
      "type": "text", "id": "takeaway", "x": 120, "y": 690, "width": 1180, "height": 22,
      "text": "Fewer handshakes & stalls →  new conn/request  →  persistent conn  →  multiplexed / 1 conn  →  independent streams (+ 0-RTT)",
      "originalText": "Fewer handshakes & stalls →  new conn/request  →  persistent conn  →  multiplexed / 1 conn  →  independent streams (+ 0-RTT)",
