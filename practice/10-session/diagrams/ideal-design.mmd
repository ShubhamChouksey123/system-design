%%{init: {"flowchart": {"curve": "basis"}}}%%
flowchart LR
    classDef clientCls fill:#ede7f6,stroke:#5e35b1,color:#311b92;
    classDef edgeCls fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef coreCls fill:#ffebee,stroke:#c62828,color:#b71c1c;
    classDef spineCls fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef storeCls fill:#fff8e1,stroke:#f9a825,color:#795548;
    classDef readCls fill:#e0f7fa,stroke:#00838f,color:#006064;
    classDef bufCls fill:#eceff1,stroke:#546e7a,color:#263238;

    Trader([Trader - places orders]):::clientCls
    GW["Order gateway<br/>check login, check balance,<br/>reserve funds from wallet - no slow payment on the fast path<br/>route order by stock_id - consistent hashing or shard map"]:::edgeCls
    WALLET[("Wallet / balances<br/>available + reserved money<br/>pre-loaded, topped up separately")]:::storeCls
    SEQ["Sequencer - one active writer per partition<br/>stamp an ever-increasing number,<br/>write to the log BEFORE matching"]:::spineCls
    JOURNAL[("Input log - write-once<br/>the durable record; replay rebuilds the books<br/>copied x3, feeds the standby")]:::spineCls

    ME["Matching engine - THE CORE<br/>in-memory order book per stock<br/>best price first, then oldest first<br/>one thread per stock, stocks spread across machines<br/>matches in microseconds, no disk or network on the fast path<br/>emits results fire-and-forget, holds no client connections"]:::coreCls
    STBY["Standby engine<br/>replays the same log, ready to take over"]:::coreCls

    RB1["Price ring buffer<br/>lock-free, single-writer<br/>drop / conflate on overflow"]:::bufCls
    RB2["Trade ring buffer<br/>SEPARATE buffer - the slow Kafka path<br/>can never gate the fast price path"]:::bufCls
    TP["Trade publisher<br/>reads by cursor, produces to Kafka<br/>acks=all + retry + DLQ, all off the hot path"]:::readCls

    MD["Price publisher<br/>normalize + conflate, stamp per-symbol seq<br/>publish once, and write the latest snapshot"]:::readCls
    BUS["Internal multicast bus - Aeron / UDP<br/>one send reaches every edge node - 1 to thousands"]:::readCls
    EDGE["Edge fan-out tier - WebSocket / SSE<br/>holds the client connections<br/>one update in, push to all clients - thousands to millions"]:::readCls
    CACHE[("Edge cache - latest snapshot<br/>bootstraps new clients, absorbs pollers")]:::readCls
    ReadC([Viewers - live price feed]):::clientCls

    SETTLE["Clearing / settlement<br/>runs in the background, off the fast path<br/>move cash + shares, pay the seller"]:::edgeCls
    KAFKA["Kafka - after-trade events<br/>retry + dead-letter queue + wallet-credit fallback"]:::spineCls
    TRADEDB[("Trade log - write-once<br/>trades for compliance + history")]:::storeCls
    PORT[("Portfolio / positions<br/>user_id, symbol, qty, avg_price")]:::storeCls
    PROFILE[("Stock profile + read replica + cache<br/>slow-changing company data")]:::readCls

    Trader -->|"1 place order"| GW
    GW -->|"2 reserve balance"| WALLET
    GW -->|"3 validated order, routed by stock_id"| SEQ
    SEQ -->|"4 stamp seq, append to the log"| JOURNAL
    JOURNAL -->|"5 engine reads the stream by cursor<br/>same read replays on recovery"| ME
    JOURNAL -->|"5 standby reads the same stream<br/>by its own cursor"| STBY
    ME -->|"6 write execution + book delta<br/>fire-and-forget"| RB1
    RB1 -->|"price publisher reads by cursor"| MD
    ME -->|"7 write after-trade event"| RB2
    RB2 -->|"trade publisher reads by cursor"| TP
    TP -->|"produce, acks=all + retry"| KAFKA
    MD -->|"6a write snapshot"| CACHE
    MD -->|"6b publish once"| BUS
    BUS -->|"multicast to edge nodes"| EDGE
    EDGE -->|"6c push deltas - SSE / WS"| ReadC
    ReadC -.->|"6d snapshot on connect, resync on seq gap"| CACHE
    KAFKA -->|"8a settle + pay seller"| SETTLE
    KAFKA -->|"8b update holdings"| PORT
    KAFKA -->|"8c record the trade"| TRADEDB
    SETTLE -->|"credit / debit"| WALLET
    ReadC -->|"read stock profile"| PROFILE
