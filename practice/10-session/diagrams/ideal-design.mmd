%%{init: {"flowchart": {"curve": "basis"}}}%%
flowchart LR
    classDef clientCls fill:#ede7f6,stroke:#5e35b1,color:#311b92;
    classDef edgeCls fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef coreCls fill:#ffebee,stroke:#c62828,color:#b71c1c;
    classDef spineCls fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef storeCls fill:#fff8e1,stroke:#f9a825,color:#795548;
    classDef readCls fill:#e0f7fa,stroke:#00838f,color:#006064;

    Trader([Trader - places orders]):::clientCls
    GW["Order gateway<br/>check login, check balance,<br/>reserve funds from wallet - no slow payment on the fast path"]:::edgeCls
    WALLET[("Wallet / balances<br/>available + reserved money<br/>pre-loaded, topped up separately")]:::storeCls
    SEQ["Sequencer<br/>stamp an ever-increasing number,<br/>write to the log BEFORE matching"]:::spineCls
    JOURNAL[("Input log - write-once<br/>the durable record; replay rebuilds the books<br/>copied x3, feeds the standby")]:::spineCls

    ME["Matching engine - THE CORE<br/>in-memory order book per stock<br/>best price first, then oldest first<br/>one thread per stock, stocks spread across machines<br/>matches in microseconds, no disk or network on the fast path"]:::coreCls
    STBY["Standby engine<br/>replays the same log, ready to take over"]:::coreCls

    MD["Price publisher<br/>pushes out trades + book changes"]:::readCls
    EDGE["Fan-out layer<br/>WebSocket / SSE + edge cache<br/>absorbs 100M reads/sec"]:::readCls
    ReadC([Viewers - live price feed]):::clientCls

    SETTLE["Clearing / settlement<br/>runs in the background, off the fast path<br/>move cash + shares, pay the seller"]:::edgeCls
    KAFKA["Kafka - after-trade events<br/>retry + dead-letter queue + wallet-credit fallback"]:::spineCls
    TRADEDB[("Trade log - write-once<br/>trades for compliance + history")]:::storeCls
    PORT[("Portfolio / positions<br/>user_id, symbol, qty, avg_price")]:::storeCls
    PROFILE[("Stock profile + read replica + cache<br/>slow-changing company data")]:::readCls

    Trader -->|"1 place order"| GW
    GW -->|"2 reserve balance"| WALLET
    GW -->|"3 validated order"| SEQ
    SEQ -->|"4 write to log first"| JOURNAL
    SEQ -->|"5 feed the ordered stream"| ME
    JOURNAL -.->|"replay on recovery"| ME
    JOURNAL -.->|"same stream"| STBY
    ME -->|"6 trade + book change"| MD
    ME -->|"7 send after-trade event"| KAFKA
    MD --> EDGE
    EDGE -->|"push live prices"| ReadC
    KAFKA -->|"8a settle + pay seller"| SETTLE
    KAFKA -->|"8b update holdings"| PORT
    KAFKA -->|"8c record the trade"| TRADEDB
    SETTLE -->|"credit / debit"| WALLET
    ReadC -->|"read stock profile"| PROFILE
