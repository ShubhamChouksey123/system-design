%%{init: {"flowchart": {"curve": "basis"}}}%%
flowchart LR
    classDef clientCls fill:#ede7f6,stroke:#5e35b1,color:#311b92;
    classDef edgeCls fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef svcCls fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef storeCls fill:#fff8e1,stroke:#f9a825,color:#795548;
    classDef busCls fill:#fce4ec,stroke:#c2185b,color:#880e4f;
    classDef fileCls fill:#f1f8e9,stroke:#9e9d24,color:#827717;

    Sender([Sender client]):::clientCls
    Recv([Recipient clients<br/>persistent WebSocket]):::clientCls

    subgraph EDGE[Connection tier - stateful, one persistent WebSocket per online device]
        direction TB
        GW["API Gateway - WebSocket<br/>terminate WS + authenticate<br/>horizontally scaled, connection draining on drain"]:::edgeCls
        REG[("Session store<br/>Redis: user_id → gateway_id<br/>heartbeat TTL")]:::storeCls
        ACT[("User activity store<br/>Redis: user_id → last_active_at<br/>online / last-seen derived from TTL")]:::storeCls
        GW <-->|"register on connect<br/>expire on disconnect"| REG
    end

    subgraph CORE[Message-handling services - stateless]
        direction TB
        WSVC["Message Writer service<br/>assigns message_id + per-conversation seq_no<br/>persist-then-ack, then emit event"]:::svcCls
        WORKER["Delivery worker<br/>Kafka consumer: expand members,<br/>batch presence lookup, route to owning gateways"]:::svcCls
        RSVC["Message Read service<br/>history scroll-back + reconnect sync<br/>read-only, cache in front of replica"]:::svcCls
        FSVC["File / media service<br/>mints file_id, signed URLs, resolves renditions"]:::fileCls
    end

    subgraph BUS[Event backbone + fan-out routing]
        direction TB
        KAFKA{{"Kafka topic: messages<br/>durable event backbone"}}:::busCls
        FANOUT["Other consumers<br/>unread counts · search index · analytics"]:::svcCls
        MQ{{"Per-gateway topics / pub-sub<br/>route message → owning gateway"}}:::busCls
        PUSH["Push service<br/>AWS SNS / Google FCM for offline recipients"]:::svcCls
    end

    subgraph DATA[Durable stores]
        direction TB
        MSTORE[("Message store - NoSQL<br/>sharded by conversation_id<br/>one row per message, seq_no order, nullable file_id")]:::storeCls
        REPLICA[("Message store read replica<br/>serves history reads")]:::storeCls
        CURSOR[("Per-recipient sync cursor<br/>last_delivered_seq / last_read_seq per user, per conversation")]:::storeCls
        GRP[("Group / conversation store<br/>members, metadata - cached")]:::storeCls
        MSTORE -->|"replication"| REPLICA
    end

    subgraph FILES[Media path]
        direction TB
        S3[("Object store - S3<br/>original + compressed + thumb per file_id<br/>hot; tier to Glacier when cold")]:::fileCls
        CMP["Compression / transcode pipeline<br/>Kafka → write renditions"]:::fileCls
        CDN["CDN<br/>serves media by signed URL"]:::fileCls
        S3 -->|"F4 transcode event"| CMP
        CMP -->|"write renditions"| S3
    end

    %% ---------- send + deliver spine (numbered) ----------
    Sender -->|"1 WS frame: send to conversation_id"| GW
    GW -->|"2 POST message"| WSVC
    WSVC -->|"3 persist msg + seq_no BEFORE ack"| MSTORE
    WSVC -.->|"4 ack: sent"| Sender
    WSVC -->|"5 produce ONE event"| KAFKA
    WSVC -.->|"update last_active_at"| ACT
    KAFKA -->|"6 consume"| WORKER
    KAFKA -.->|"same event, many readers"| FANOUT
    WORKER -->|"7 expand members - group only"| GRP
    WORKER -->|"8 where is each recipient?"| REG
    WORKER -.->|"update last_active_at"| ACT
    WORKER -->|"9 publish to owning gateways"| MQ
    MQ -->|"10 online → deliver"| GW
    GW -->|"11 push WS frame"| Recv
    MQ -.->|"offline → notify"| PUSH
    PUSH -.->|"wake device"| Recv
    Recv -.->|"12 delivered / read ack → advance cursor"| CURSOR

    %% ---------- reconnect + history read (scroll back) ----------
    Recv -->|"R1 reconnect / scroll: load since seq_no"| GW
    GW --> RSVC
    RSVC -->|"R2 read gap / page by seq_no"| REPLICA
    RSVC -->|"R2 read cursor"| CURSOR

    %% ---------- file path ----------
    Sender -->|"F1 request upload"| GW
    GW --> FSVC
    FSVC -->|"F2 file_id + signed PUT URL"| Sender
    Sender -->|"F3 upload original bytes directly"| S3
    Recv -->|"F5 open media: resolve file_id"| FSVC
    FSVC -->|"F6 signed CDN URL"| Recv
    Recv -->|"F7 download by signed URL"| CDN
