%%{init: {"flowchart": {"curve": "basis"}}}%%
flowchart LR
    classDef clientCls fill:#ede7f6,stroke:#5e35b1,color:#311b92;
    classDef gwCls fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef svcCls fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef storeCls fill:#fff8e1,stroke:#f9a825,color:#795548;
    classDef busCls fill:#fce4ec,stroke:#c2185b,color:#880e4f;
    classDef pushCls fill:#ffebee,stroke:#c62828,color:#b71c1c;

    Alice([Alice - sender]):::clientCls
    GWA["Gateway-A"]:::gwCls
    SVC["Send / Message service<br/>assigns message_id + seq_no"]:::svcCls
    MSTORE[("Message store<br/>shard = conversation group-123")]:::storeCls
    KAFKA{{"Kafka topic: messages<br/>durable event backbone"}}:::busCls

    WORKER["Delivery worker<br/>Kafka consumer"]:::svcCls
    GRP[("Group store<br/>members of group-123")]:::storeCls
    REG[("Presence registry<br/>user_id → gateway_id")]:::storeCls

    GWB["Gateway-B → Bob"]:::gwCls
    GWC["Gateway-C → Carol"]:::gwCls
    PUSH["Push service → Dave offline"]:::pushCls
    Members([Bob and Carol receive push · Dave gets notification]):::clientCls

    Alice -->|"1 WS frame: send to group-123"| GWA
    GWA --> SVC
    SVC -->|"2 persist ONCE + ack Alice"| MSTORE
    SVC -->|"3 produce ONE event"| KAFKA
    KAFKA -->|"4 consume"| WORKER
    WORKER -->|"5 expand members"| GRP
    GRP -->|"[Bob, Carol, Dave]"| WORKER
    WORKER -->|"6 look up each member's gateway"| REG
    WORKER -->|"7a → Bob online"| GWB
    WORKER -->|"7b → Carol online"| GWC
    WORKER -.->|"7c Dave offline → notify"| PUSH
    GWB --> Members
    GWC --> Members
    PUSH -.-> Members
